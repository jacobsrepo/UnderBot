53.05999999999995 226.06) (xy 353.05999999999995 210.82)) (stroke (width 0) (type default)) (uuid edb0e038-5d9a-5945-a511-81b4ac91f38b))(wire (pts (xy 353.05999999999995 210.82) (xy 370.84 210.82)) (stroke (width 0) (type default)) (uuid ed065a40-6b0f-58b0-95e0-6b909f966083))(text "A801 V+ stays unconnected.\nOnly PWM signals come from this board.\nHigh-current power uses separate\nfused distribution and return wiring." (at 20 177 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 2c9764c5-b961-5dea-b666-05dfd53d8360))(text "J801-J810: OUR harness convention\n1=GND, 2=fused power, 3=signal.\nConfirm actual servo plug orientation.\nCH10-15 unused; not represented." (at 20 208 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 7728c0a9-a28d-565f-8823-fd5165290a01))(text "Candidate PWM servos: FT5335M arm joints; FT5121M grippers/pan/tilt. Mechanical sizing is not approved." (at 20 246 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 288f810f-66d2-5509-bfd9-5d8d2f6d2faa))(text "Rail must suit final servos (candidate range 6-7.4V), never raw 6S or 12V. Fuse/cable ratings TBD from measured demand." (at 20 254 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 3f89aac5-5a99-5695-a5a9-3ae8ef6f4e34))(text "Power removal may let arms fall. Complete hardware stop, restraints/braking, startup bias and pulse calibration before operation." (at 20 262 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 2eaf39e0-2edc-5b70-ba78-de9225a79f37)) (embedded_fonts no))