	(text "J306 NTC + R303 form an ADC divider; C301 filters noise. Confirm thermistor curve and ESP32 ADC range/calibration."
		(exclude_from_sim no)
		(at 20 211 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "32560a83-7853-5ea3-9392-e78d2f8c1f1d")
	)
	(text "ESP32 IS USB-POWERED FROM THE PI. ALL SIGNAL LEVELS HERE ARE 3.3V."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "8ce0c074-edfd-58f7-bf41-1185ac99f990")
	)
	(text "The mux is OFF-BOARD. Its channel ports are J305; it is not replaced by shorting the SDA/SCL lines together."
		(exclude_from_sim no)
		(at 20 229 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c03fd94e-55c1-5f3d-bcab-2c10a7598c99")
	)
	(text "ToF expansion and any IMU interrupt/reset wiring will be added after board selection. Sensor connectors are NOT Qwiic pinouts."
		(exclude_from_sim no)
		(at 20 238 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ca8450ce-d424-5f6e-af43-d6d1fe329514")
	)
	(text "A dedicated mux channel is required for any PCA9685 at default 0x40 (conflicts with U101). See sheet 05."
		(exclude_from_sim no)
		(at 20 247 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
