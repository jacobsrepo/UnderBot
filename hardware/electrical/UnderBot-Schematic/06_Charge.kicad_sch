	(text "Mechanical connector selection, touch protection and fuse coordination are still required before connecting real batteries."
		(exclude_from_sim no)
		(at 20 224 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "35d87465-e8c7-5798-8df3-4500be60d9f5")
	)
	(text "NOT IN THIS REVISION: unattended dock contacts/interlock, parallel solar + mains sources, charge-source OR-ing or supercapacitors."
		(exclude_from_sim no)
		(at 20 180 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "5dcfa7da-d33e-5668-87db-2ce7ffcaa01b")
	)
	(text "Use a finished 6S Li-ion charger with termination, temperature policy and reverse-current protection; 4A is a candidate limit."
		(exclude_from_sim no)
		(at 20 148 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "5eea7769-6121-567d-9985-47a3a26128a1")
	)
	(text "Uses the common-port BMS topology: charge positive -> F601 -> F101 -> pack positive; return -> protected BMS return."
		(exclude_from_sim no)
		(at 20 124 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "65cf350e-25a6-513c-92b7-917d1bc8eef0")
	)
	(text "If the selected BMS has a separate C- port, this sheet MUST change. Never wire charger return directly to raw cell negative."
		(exclude_from_sim no)
		(at 20 136 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "7aad6ecf-582d-5d7d-8e70-255bfb36f10a")
	)
	(text "Prototype charging procedure: service switch OFF; appropriate pack/BMS fitted; one source; no energized motion."
		(exclude_from_sim no)
		(at 20 160 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "911c6010-8f42-56d4-bf5c-f4c30f3f7703")
	)
	(text "Station PV / LiFePO4 / buck-boost charger remains an EXTERNAL subsystem in the architecture drawing. No station PCB is implied."
		(exclude_from_sim no)
		(at 20 192 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "9aaac7ce-71e1-5c53-95c7-ed8925d58eaf")
	)
	(text "The original T12 dock/battery is independent. Neither T12 battery terminals nor its 20V charging input accepts 25.2V directly."
		(exclude_from_sim no)
		(at 20 204 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "c05933d3-c930-55fe-928c-16c921051184")
	)
