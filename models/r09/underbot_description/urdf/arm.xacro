    <joint name="right_gripper_right_joint" type="revolute">
      <parent link="right_hand" />
      <child link="right_gripper_right" />
      <origin xyz="0.025 -0.018 0" rpy="0 0 0" />
      <axis xyz="0 0 -1" />
      <limit effort="0.3" velocity="1" lower="0" upper="0.6" />
      <dynamics damping=".1" friction=".02" />
      <mimic joint="right_gripper_left_joint" multiplier="1" offset="0" />
    </joint>
  </xacro:macro>
</robot>
